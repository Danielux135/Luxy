{
  "name": "@luxy/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Luxy Desktop - aplicacion de escritorio para Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.agent.config.ts && vite build --config vite.capture-preload.config.ts",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@luxy/agent": "*",
    "@luxy/remote-crypto": "*",
    "@luxy/remote-protocol": "*",
    "@luxy/shared": "*",
    "koffi": "^3.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^5.4.21"
  }
}

# -----------------------------------------------------------------------------
# Luxy - variables de entorno de ejemplo
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# Estos valores son PENDIENTES: no hay credenciales reales en este repositorio.
# -----------------------------------------------------------------------------

# --- Solo para desarrollo local del Worker (wrangler dev usa .dev.vars) --------
# Token del bot que te da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=PENDIENTE_TOKEN_DE_BOTFATHER

# Cadena aleatoria que tu generas: Telegram la envia en la cabecera del webhook
# Generar con: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
TELEGRAM_WEBHOOK_SECRET=PENDIENTE_CADENA_ALEATORIA

# Tu id numerico de usuario de Telegram (pregunta a @userinfobot)
TELEGRAM_ADMIN_USER_ID=PENDIENTE_ID_NUMERICO

# Ids de chats autorizados separados por coma (privado y/o grupos)
TELEGRAM_ALLOWED_CHAT_IDS=PENDIENTE_ID_CHAT

# Proyecto de Supabase
SUPABASE_URL=https://PENDIENTE.supabase.co

# ATENCION: esta clave SOLO debe existir como secret de Cloudflare.
# Nunca la guardes en los ordenadores locales ni en este archivo en produccion.
SUPABASE_SERVICE_ROLE_KEY=PENDIENTE_SERVICE_ROLE_KEY

# Secreto temporal para dar de alta una maquina nueva (rotalo tras usarlo)
MACHINE_REGISTRATION_SECRET=PENDIENTE_SECRETO_DE_REGISTRO

# --- Opcional: ajustes de comportamiento del gateway --------------------------
# Segundos sin heartbeat tras los que una maquina se considera desconectada
LUXY_MACHINE_OFFLINE_SECONDS=45

# Segundos de duracion del lease de un trabajo reclamado
LUXY_JOB_LEASE_SECONDS=120

# -----------------------------------------------------------------------------
# Luxy - claves de las APIs configurables (modelos chinos)
# Copia a .env.providers en CADA ordenador. NUNCA subas este archivo relleno.
#
# Estas claves las lee unicamente el AGENTE LOCAL, nunca el gateway,
# nunca Supabase, nunca Telegram y nunca los logs.
#
# Claude Code y Codex CLI NO aparecen aqui a proposito: usan la sesion local
# de tu suscripcion. Luxy nunca usa ANTHROPIC_API_KEY ni OPENAI_API_KEY.
# -----------------------------------------------------------------------------

DEEPSEEK_API_KEY=PENDIENTE_CLAVE_DEEPSEEK
GLM_API_KEY=PENDIENTE_CLAVE_GLM
QWEN_API_KEY=PENDIENTE_CLAVE_QWEN

# Los baseUrl y los modelos NO se codifican aqui: se configuran en
# %APPDATA%\Luxy\config.json (seccion "providers"), porque cambian con el tiempo.
# Consulta docs/PROVIDERS.md para los valores actuales de cada servicio.
